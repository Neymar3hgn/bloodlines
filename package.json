{
    "name":  "clade",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "An AI swarm that has to earn its next generation. Built at NEAR HACKATHON.",
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=22.18"
                },
    "scripts":  {
                    "test":  "node --test engine/market.test.ts sim/world.test.ts",
                    "sim":  "node sim/run.ts",
                    "vectors":  "node scripts/make-vectors.ts",
                    "build":  "powershell -NoProfile -File scripts/build.ps1",
                    "deploy":  "node scripts/deploy.ts",
                    "e2e":  "node scripts/e2e.ts",
                    "verify":  "node scripts/verify.ts",
                    "season":  "node swarm/season.ts",
                    "experiment":  "node swarm/experiment.ts",
                    "replay":  "node swarm/experiment.ts --replay",
                    "snapshot":  "node swarm/snapshot.ts",
                    "mcp":  "node tools/clade-mcp.ts"
                },
    "dependencies":  {
                         "@noble/curves":  "^2.4.0",
                         "@noble/hashes":  "^2.4.0",
                         "near-api-js":  "^7.4.0"
                     }
}
